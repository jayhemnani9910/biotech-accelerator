# Biotech Research Accelerator — environment configuration
#
# The current pipeline is DETERMINISTIC and requires no LLM or web-search API
# key. Only the variables below are read by the code; each one is read by the
# adapter that uses it (PubMedAdapter, PDBAdapter) and covered by a test in
# tests/test_config_env.py. LLM-powered nodes are planned for a later iteration
# and are intentionally not wired up yet.

# --- PubMed (NCBI E-utilities) ---
# Contact email sent with NCBI requests. Recommended to avoid rate-limit
# throttling. Defaults to biotech-accelerator@example.com if unset.
# PUBMED_EMAIL=your_email@example.com

# Optional NCBI API key for higher PubMed rate limits.
# PUBMED_API_KEY=your_ncbi_api_key_here

# --- PDB (RCSB) ---
# Directory for cached PDB structure files.
# Defaults to ~/.biotech-accelerator/pdb_cache if unset.
# PDB_CACHE_DIR=~/.biotech-accelerator/pdb_cache

# UniProt, RCSB PDB, and ChEMBL require no API key.
